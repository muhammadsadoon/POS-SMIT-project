rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user role from users collection (with null check)
    function getUserRole() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Helper function to check if user is manager or admin
    function isManagerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'manager' || getUserRole() == 'admin');
    }

    // Helper function to check if user is a member of a project
    // Checks up to 20 members (Firestore rules limitation)
    function isMemberOfProject(members) {
      return members != null && members.size() > 0 && (
        // Check first 10 members
        (members.size() > 0 && members[0].uid == request.auth.uid) ||
        (members.size() > 1 && members[1].uid == request.auth.uid) ||
        (members.size() > 2 && members[2].uid == request.auth.uid) ||
        (members.size() > 3 && members[3].uid == request.auth.uid) ||
        (members.size() > 4 && members[4].uid == request.auth.uid) ||
        (members.size() > 5 && members[5].uid == request.auth.uid) ||
        (members.size() > 6 && members[6].uid == request.auth.uid) ||
        (members.size() > 7 && members[7].uid == request.auth.uid) ||
        (members.size() > 8 && members[8].uid == request.auth.uid) ||
        (members.size() > 9 && members[9].uid == request.auth.uid) ||
        // Check next 10 members
        (members.size() > 10 && members[10].uid == request.auth.uid) ||
        (members.size() > 11 && members[11].uid == request.auth.uid) ||
        (members.size() > 12 && members[12].uid == request.auth.uid) ||
        (members.size() > 13 && members[13].uid == request.auth.uid) ||
        (members.size() > 14 && members[14].uid == request.auth.uid) ||
        (members.size() > 15 && members[15].uid == request.auth.uid) ||
        (members.size() > 16 && members[16].uid == request.auth.uid) ||
        (members.size() > 17 && members[17].uid == request.auth.uid) ||
        (members.size() > 18 && members[18].uid == request.auth.uid) ||
        (members.size() > 19 && members[19].uid == request.auth.uid)
      );
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can create their own document during signup
      allow create: if isAuthenticated() && 
                     request.auth.uid == userId &&
                     request.resource.data.uid == request.auth.uid;
      
      // Users can update their own data, admins can update anyone
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      // Helper function to check if user is project owner
      function isProjectOwner() {
        return resource != null && 
               resource.data != null &&
               resource.data.ownerId == request.auth.uid;
      }
      
      // Helper function to check if user is project member
      function isProjectMember() {
        return resource != null && 
               resource.data != null &&
               resource.data.members != null &&
               isMemberOfProject(resource.data.members);
      }

      // Allow read if user is owner or member
      allow read: if isAuthenticated() && (
        isProjectOwner() || isProjectMember()
      );
      
      // Allow create if authenticated (user becomes owner)
      allow create: if isAuthenticated() && 
                     request.resource.data.ownerId == request.auth.uid &&
                     request.resource.data.members != null &&
                     request.resource.data.members.size() > 0;
      
      // Allow update if user is owner or admin/manager member
      allow update: if isAuthenticated() && (
        isProjectOwner() || 
        (isProjectMember() && isManagerOrAdmin())
      );
      
      // Allow delete only if user is owner
      allow delete: if isAuthenticated() && isProjectOwner();
    }

    // Products collection
    match /products/{productId} {
      // Helper to check if user has access to the product's project
      function hasProjectAccess() {
        return resource != null && 
               resource.data != null &&
               resource.data.projectId != null &&
               exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
               (
                 get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid || 
                 (get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members != null && 
                  isMemberOfProject(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members))
               );
      }

      function hasProjectAccessForCreate() {
        return request.resource.data.projectId != null &&
               exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
               (
                 get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid || 
                 (get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.members != null && 
                  isMemberOfProject(get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.members))
               );
      }

      // Staff can read products in their projects
      allow read: if isAuthenticated() && hasProjectAccess();
      
      // Only managers and admins can create products
      allow create: if isAuthenticated() && 
                     hasProjectAccessForCreate() && 
                     isManagerOrAdmin();
      
      // Only managers and admins can update products (password verification happens in app)
      allow update: if isAuthenticated() && 
                     hasProjectAccess() && 
                     isManagerOrAdmin();
      
      // Only managers and admins can delete products (password verification happens in app)
      allow delete: if isAuthenticated() && 
                     hasProjectAccess() && 
                     isManagerOrAdmin();
    }

    // Sales collection
    match /sales/{saleId} {
      // Helper to check if user has access to the sale's project
      function hasProjectAccess() {
        return resource != null && 
               resource.data != null &&
               resource.data.projectId != null &&
               exists(/databases/$(database)/documents/projects/$(resource.data.projectId)) &&
               (
                 get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.ownerId == request.auth.uid || 
                 (get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members != null && 
                  isMemberOfProject(get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members))
               );
      }

      function hasProjectAccessForCreate() {
        return request.resource.data.projectId != null &&
               exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId)) &&
               (
                 get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid || 
                 (get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.members != null && 
                  isMemberOfProject(get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.members))
               );
      }

      // Users can read sales in their projects
      allow read: if isAuthenticated() && hasProjectAccess();
      
      // Staff, managers, and admins can create sales
      allow create: if isAuthenticated() && hasProjectAccessForCreate();
      
      // Only managers and admins can update/delete sales
      allow update: if isAuthenticated() && hasProjectAccess() && isManagerOrAdmin();
      allow delete: if isAuthenticated() && hasProjectAccess() && isAdmin();
    }
  }
}
